generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(uuid())
  username           String              @unique
  // bcrypt hash. Accounts from before hashing may still hold plain text
  // until their next sign-in (electron/main/passwords.js).
  passwordHash       String
  // True for new accounts and after an admin sets a password: the user must
  // choose their own password at the next sign-in.
  mustChangePassword Boolean             @default(false)
  firstName          String
  lastName           String
  email              String?
  status             UserStatus
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  userRoles          UserRole[]
  qualifications     UserQualification[]
  auditLogs          AuditLog[]
  backups            Backup[]
}

model Role {
  id          String           @id @default(uuid())
  roleName    String           @unique
  description String?
  userRoles   UserRole[]
  permissions RolePermission[]
}

model Permission {
  id             String           @id @default(uuid())
  permissionCode String           @unique
  name           String
  category       String
  roles          RolePermission[]
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId], name: "userId_roleId")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model Configuration {
  id          String  @id @default(uuid())
  key         String  @unique
  value       String
  description String?
}

// action is still free text (for example QUALIFICATION_ASSIGNED). The Prisma
// Schema spec's AuditAction enum can replace it once all callers are updated.
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  entity    String
  entityId  String?
  action    String
  oldValue  String?
  newValue  String?
  timestamp DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([timestamp])
}

model Backup {
  id           String   @id @default(uuid())
  backupName   String
  fileLocation String
  createdAt    DateTime @default(now())
  createdBy    String?
  sizeBytes    BigInt
  user         User?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)
}

// A subject such as OM-A or Maintenance (owner question 15: code plus name).
// subjectName is the display name.
model Subject {
  id          String     @id @default(uuid())
  code        String     @unique
  subjectName String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  questions   Question[]
}

// One question-bank question. Imported banks use the format agreed with Quail
// (commons/direct/finch-quail.md in wren-sandbox): externalId is the bank's
// questionId, so re-importing updates instead of duplicating. answer holds
// the older free-text answer of questions entered by hand.
model Question {
  id             String    @id @default(uuid())
  externalId     String?   @unique
  questionText   String
  answerA        String?
  answerB        String?
  answerC        String?
  answerD        String?
  correctAnswer  String?
  reference      String?
  category       String?
  section        String?
  difficulty     String?
  sourceRevision String?
  active         Boolean   @default(true)
  answer         String?
  subjectId      String?
  subject        Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  // The manual the question comes from (owner, 2026-11-20: one pool of
  // questions, filtered by source document for quizzes, tests and references).
  documentId     String?
  document       Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([subjectId])
  @@index([documentId])
}

// A catalog entry such as PIC or HUET. Dates belong to each person's
// assignment (UserQualification), not to the catalog entry.
// renewalMonths is how long an award lasts; null means it does not expire.
model Qualification {
  id            String              @id @default(uuid())
  code          String              @unique
  name          String              @unique
  description   String?
  renewalMonths Int?
  active        Boolean             @default(true)
  // Hidden by an administrator because it was created in error (owner
  // decision 2026-11-19, question 24). History is kept; lists leave it out.
  hidden        Boolean             @default(false)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  assignments   UserQualification[]
}

model UserQualification {
  id              String           @id @default(uuid())
  userId          String
  qualificationId String
  assignedAt      DateTime         @default(now())
  completedAt     DateTime?
  revokedAt       DateTime?
  endReason       String?
  status          AssignmentStatus @default(ACTIVE)
  awardedDate     DateTime?
  expirationDate  DateTime?
  suspended       Boolean          @default(false)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  qualification   Qualification    @relation(fields: [qualificationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([qualificationId])
  @@index([status])
  @@index([expirationDate])
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum QualificationStatus {
  CURRENT
  EXPIRING
  EXPIRING_CRITICAL
  EXPIRED
  SUSPENDED
}

enum AssignmentStatus {
  ACTIVE
  COMPLETED
  REVOKED
}

// A reference document such as the Operations Manual (Prisma Schema spec
// v1.0). filePath is optional until the reference library (Phase 7) stores
// the PDFs; versions and page references come with that phase.
model Document {
  id            String     @id @default(uuid())
  code          String     @unique
  title         String
  description   String?
  version       String?
  filePath      String?
  effectiveDate DateTime?
  active        Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  questions     Question[]
}
