# Packages
node_modules/

# Secrets and local settings. .env.example is the template and is kept.
.env
.env.*
!.env.example

# SQLite databases are made locally by `prisma migrate deploy` and
# `prisma db seed` (see README). Never commit them.
*.db
*.db-journal
*.sqlite
*.sqlite3

# Database backups (made next to the database) and the app's logs
prisma/backups/
logs/
*.log

# Build output: screens, bundled seed, installer
dist/
dist-electron/
release/

# Tools
.vite/
vite.config.ts.timestamp-*
coverage/
*.tsbuildinfo
.vscode/
.idea/

# Operating system files
.DS_Store
Thumbs.db
desktop.ini
