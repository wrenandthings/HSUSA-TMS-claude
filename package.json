{
  "name": "hsusa-tms",
  "version": "1.0.0",
  "description": "HSUSA Training Management System (TMS)",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "electron .",
    "pretest": "prisma generate",
    "test": "vitest run",
    "dev:blank-admin": "node scripts/dev-blank-admin.js",
    "postinstall": "prisma generate",
    "build:seed": "esbuild prisma/seed.ts --bundle --platform=node --format=cjs --external:@prisma/client --external:bcryptjs --outfile=dist-electron/seed.cjs --log-level=warning",
    "dist": "npm run build && npm run build:seed && electron-builder --win nsis --publish never"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eonlihgalt/HSUSA-TMS.git"
  },
  "bugs": {
    "url": "https://github.com/eonlihgalt/HSUSA-TMS/issues"
  },
  "homepage": "https://github.com/eonlihgalt/HSUSA-TMS#readme",
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "bcryptjs": "^3.0.3"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/inter-tight": "5.3.0",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "prisma": "^6.15.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.1.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "productName": "HSUSA TMS",
  "build": {
    "appId": "com.heliserviceusa.tms",
    "productName": "HSUSA TMS",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "electron/**/*",
      "dist/**/*",
      "dist-electron/**/*",
      "prisma/migrations/**/*",
      "prisma/schema.prisma",
      "documents/question-banks/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "HSUSA-TMS-Setup-${version}.exe",
      "shortcutName": "HSUSA TMS"
    },
    "asar": false,
    "extraResources": [
      {
        "from": "node_modules/.prisma",
        "to": "app/node_modules/.prisma",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
